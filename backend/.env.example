# === Обязательные ===
DEBUG=true
SECRET_KEY=your-secret-key-use-openssl-rand-hex-32
DATABASE_URL=postgresql+asyncpg://dorvey:dorvey@localhost:5432/dorvey
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# === Default admin (first deploy, if no users) ===
# DEFAULT_ADMIN_EMAIL=admin@dorvey.local
# DEFAULT_ADMIN_PASSWORD=ChangeMeNow123!

# === AI ===
OPENAI_API_KEY=

# === CORS ===
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

