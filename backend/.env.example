# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=dorvey
# S3_REGION=us-east-1

# === Уведомления ===
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
